# Ejemplo de archivo .env para configuración local
# Copia este archivo como '.env' en la raíz del proyecto y completa con tus credenciales.
# El archivo '.env' está en .gitignore para evitar subir credenciales privadas.

# Configuración de base de datos para Railway (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://<HOST>:<PORT>/<DATABASE>
SPRING_DATASOURCE_USERNAME=<USER>
SPRING_DATASOURCE_PASSWORD=<PASSWORD>
SPRING_DATASOURCE_NAME=<DB_NAME>
SPRING_DATASOURCE_PORT=<DB_PORT>
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
